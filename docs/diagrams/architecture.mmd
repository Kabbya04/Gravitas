%%{init: {'themeVariables': {'fontSize': '24px', 'fontFamily': 'ui-sans-serif, system-ui, sans-serif'}}}%%
flowchart LR
  subgraph api [HTTP API]
    Upload[POST upload]
    Delete[DELETE document]
  end
  subgraph ingest [Ingestion]
    Router[Format router]
    Native[Native PDF text]
    OCR[Tesseract OCR]
    OcrRefine[Groq OCR refine]
    MD[MarkItDown optional]
    Chunk[Chunk plus structure]
  end
  subgraph store [Storage]
    DB[(SQLite plus files)]
    Vec[(Chroma vectors)]
    Lex[BM25 corpus texts]
  end
  subgraph retrieve [Retrieval]
    Hybrid[Hybrid retrieve and fuse]
    Pack[Evidence packaging]
  end
  subgraph gen [Generation]
    Groq[Groq draft API]
    Parse[Citation parse validate]
  end
  subgraph learn [Edit loop]
    Capture[Operator final text]
    Mine[Mine edit patterns]
    Mem[Preference memory]
  end
  Upload --> Router
  Router --> Native
  Router --> OCR
  Router --> MD
  Native --> Chunk
  OCR --> OcrRefine
  OcrRefine --> Chunk
  MD --> Chunk
  Chunk --> DB
  Chunk --> Vec
  Chunk --> Lex
  Vec --> Hybrid
  Lex --> Hybrid
  DB --> Hybrid
  Hybrid --> Pack
  Pack --> Groq
  Groq --> Parse
  Parse --> Capture
  Capture --> Mine
  Mine --> Mem
  Mem --> Pack
  Delete --> DB
  Delete --> Vec
